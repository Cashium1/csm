# ============================================================================
# 캐쉬움(CSM) 환경변수 템플릿
# ----------------------------------------------------------------------------
# 사용법:
#   - 로컬 개발:  이 파일을 복사해 ".env.local" 을 만들고 실제 값을 채웁니다.
#                 (cp .env.example .env.local)
#   - 배포:       이 값들을 배포 플랫폼(Vercel/Fly.io 등)의 "Environment Variables"에 넣습니다.
#
# 주의:
#   - NEXT_PUBLIC_ 으로 시작하는 변수는 브라우저에 노출됩니다. 시크릿에는 절대 사용하지 마세요.
#   - 실제 .env.local / .env 파일은 절대 git에 커밋하지 마세요. (이미 .gitignore에 포함)
# ============================================================================

# ── 결제 (토스페이먼츠) ─────────────────────────────────────────────────────
# 토스페이먼츠 가맹점 가입·심사 후 발급받는 키입니다. (https://www.tosspayments.com)
# 클라이언트 키: 결제창을 띄울 때 사용하는 공개 키
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx
# 시크릿 키: 서버에서 결제 승인/환불을 호출하는 비밀 키 (절대 노출 금지)
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx
# (선택) 결제/환불을 실제 호출하지 않고 흉내만 내려면 1로 설정. 운영에서는 비워두세요.
# TOSS_MOCK=

# ── 이메일 발송 (Resend) ────────────────────────────────────────────────────
# Resend 가입 후 발급받는 API 키입니다. (https://resend.com)
# 비워두면 메일이 실제로 발송되지 않고 서버 콘솔에 출력됩니다(개발 모드).
RESEND_API_KEY=
# 발신 주소. Resend에서 도메인 인증(SPF/DKIM)을 마친 주소여야 실제 발송됩니다.
# 예) "캐쉬움 <noreply@yourdomain.com>"
EMAIL_FROM=

# ── 관리자 지정 ─────────────────────────────────────────────────────────────
# 여기에 적은 이메일로 회원가입하면 자동으로 관리자 권한이 부여됩니다. (쉼표로 여러 개)
ADMIN_EMAILS=admin@yourdomain.com

# ── 데이터베이스 (SQLite) ───────────────────────────────────────────────────
# (선택) SQLite 파일을 저장할 디렉터리. 영속 볼륨이 있는 서버에 배포할 때 마운트 경로를 지정합니다.
# 미설정 시 프로젝트의 ./data 폴더를 사용합니다.
# DATA_DIR=/data
